extends CharacterBody2D

signal boss_defeated

const GROUND_Y := 470.0

var health := 220
var max_health := 220
var speed := 110.0
var attack_timer := 0.0
var phase := 1

func _ready() -> void:
    add_to_group("boss")
    $Body.color = Color(0.86, 0.16, 0.32)
    $Core.color = Color(1.0, 0.80, 0.12)
    attack_timer = 0.6

func _physics_process(delta: float) -> void:
    if health <= 0:
        return

    var player = get_tree().get_first_node_in_group("player")
    if player == null or not is_instance_valid(player):
        return

    attack_timer -= delta
    if attack_timer <= 0.0:
        do_attack(player)
        attack_timer = 0.85 if phase == 1 else 0.55

    var direction := sign(player.global_position.x - global_position.x)
    var distance := abs(player.global_position.x - global_position.x)

    if distance > 160.0:
        velocity.x = direction * speed
    else:
        velocity.x = 0.0

    if global_position.y < GROUND_Y:
        velocity.y += 1200.0 * delta
    else:
        global_position.y = GROUND_Y
        velocity.y = 0.0

    move_and_slide()

func do_attack(player: Node) -> void:
    if player.has_method("take_damage"):
        player.take_damage(12 if phase == 1 else 16)

    if health < max_health * 0.5:
        phase = 2
        spawn_support()

func spawn_support() -> void:
    var enemy_scene: PackedScene = preload("res://scenes/Enemy.tscn")
    for index in range(2):
        var enemy = enemy_scene.instantiate()
        enemy.enemy_type = "Runner" if index % 2 == 0 else "Scout"
        enemy.position = global_position + Vector2(120 * (index + 1) * (-1 if index == 0 else 1), -30)
        get_parent().add_child(enemy)

func take_damage(amount: int) -> void:
    if health <= 0:
        return
    health -= amount
    if health <= 0:
        health = 0
        emit_signal("boss_defeated")
        queue_free()
